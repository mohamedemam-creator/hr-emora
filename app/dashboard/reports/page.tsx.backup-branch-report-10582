'use client'

import { useEffect, useState } from 'react'
import { Download, FileSpreadsheet, Loader2, RefreshCw } from 'lucide-react'
import { createClient } from '@/lib/supabase/client'

type Branch={id:string;name:string;code:string}
type Row={shift_date:string;employee_code:string;employee_name:string;branch_name:string;region_name:string|null;day_type:string;planned_start:string|null;planned_end:string|null;check_in:string|null;check_out:string|null;attendance_status:string;late_minutes:number;worked_minutes:number}
const labels:Record<string,string>={work:'عمل',off:'راحة',leave:'إجازة',mission:'مأمورية',present:'حاضر',late:'متأخر',absent:'غائب',open:'داخل الشيفت',early_leave:'انصراف مبكر',missing_checkout:'بدون انصراف',under_review:'قيد المراجعة'}

function dateOffset(days:number){const d=new Date();d.setDate(d.getDate()+days);return d.toISOString().slice(0,10)}

export default function ReportsPage(){
  const [from,setFrom]=useState(dateOffset(-30))
  const [to,setTo]=useState(dateOffset(0))
  const [branchId,setBranchId]=useState('')
  const [branches,setBranches]=useState<Branch[]>([])
  const [rows,setRows]=useState<Row[]>([])
  const [loading,setLoading]=useState(false)
  const [error,setError]=useState('')

  async function load(){
    setLoading(true);setError('')
    const supabase=createClient()
    const [{data:report,error:reportError},{data:workspace}]=await Promise.all([
      supabase.rpc('app_attendance_report',{p_date_from:from,p_date_to:to,p_branch_id:branchId||null,p_region_id:null}),
      supabase.rpc('app_shift_workspace',{p_branch_id:null,p_week_start:null}),
    ])
    if(reportError)setError(reportError.message);else setRows((report??[]) as Row[])
    if(workspace)setBranches((workspace as {branches:Branch[]}).branches??[])
    setLoading(false)
  }
  useEffect(()=>{void load()},[])

  const summary={
    total:rows.filter(r=>r.day_type==='work').length,
    present:rows.filter(r=>['present','open','early_leave','missing_checkout','under_review'].includes(r.attendance_status)).length,
    late:rows.filter(r=>r.attendance_status==='late'||r.late_minutes>0).length,
    absent:rows.filter(r=>r.attendance_status==='absent').length,
  }

  async function exportExcel(){
    const XLSX=await import('xlsx')
    const data=rows.map(r=>({'التاريخ':r.shift_date,'كود الموظف':r.employee_code,'اسم الموظف':r.employee_name,'المنطقة':r.region_name??'','الفرع':r.branch_name,'نوع اليوم':labels[r.day_type]??r.day_type,'موعد البداية':r.planned_start??'','موعد النهاية':r.planned_end??'','الحضور':r.check_in??'','الانصراف':r.check_out??'','الحالة':labels[r.attendance_status]??r.attendance_status,'دقائق التأخير':r.late_minutes,'دقائق العمل':r.worked_minutes}))
    const workbook=XLSX.utils.book_new();XLSX.utils.book_append_sheet(workbook,XLSX.utils.json_to_sheet(data),'Attendance');XLSX.writeFile(workbook,`Emora_Attendance_${from}_${to}.xlsx`)
  }

  return <main className="dashboard-content">
    <section className="page-heading management-heading"><div><span className="eyebrow">بيانات فعلية</span><h1>تقارير الحضور والشيفتات</h1><p>فلترة حسب الفترة والفرع وتصدير النتائج إلى Excel.</p></div><button className="button button-ghost" onClick={()=>void exportExcel()}><FileSpreadsheet size={18}/> تصدير Excel</button></section>
    {error&&<div className="form-error management-message">{error}</div>}
    <section className="panel report-filters"><label>من<input type="date" value={from} onChange={e=>setFrom(e.target.value)}/></label><label>إلى<input type="date" value={to} onChange={e=>setTo(e.target.value)}/></label><label>الفرع<select value={branchId} onChange={e=>setBranchId(e.target.value)}><option value="">كل الفروع المسموح بها</option>{branches.map(b=><option key={b.id} value={b.id}>{b.name} — {b.code}</option>)}</select></label><button className="button button-primary" onClick={()=>void load()}><RefreshCw size={18}/> عرض التقرير</button></section>
    <section className="report-stats"><article><span>أيام العمل</span><strong>{summary.total}</strong></article><article><span>الحضور</span><strong>{summary.present}</strong></article><article><span>التأخير</span><strong>{summary.late}</strong></article><article><span>الغياب</span><strong>{summary.absent}</strong></article></section>
    <section className="panel data-table-panel">{loading?<div className="empty-state"><Loader2 className="spin"/><strong>جارٍ تحميل التقرير...</strong></div>:rows.length===0?<div className="empty-state"><Download/><strong>لا توجد بيانات في الفترة المختارة</strong></div>:<div className="responsive-table"><table className="data-table report-table"><thead><tr><th>التاريخ</th><th>الموظف</th><th>الفرع</th><th>اليوم</th><th>المخطط</th><th>الحضور</th><th>الانصراف</th><th>الحالة</th><th>التأخير</th><th>ساعات العمل</th></tr></thead><tbody>{rows.map((r,i)=><tr key={`${r.employee_code}_${r.shift_date}_${i}`}><td>{r.shift_date}</td><td><div className="primary-cell"><strong>{r.employee_name}</strong><span>{r.employee_code}</span></div></td><td><div className="primary-cell"><strong>{r.branch_name}</strong><span>{r.region_name??''}</span></div></td><td>{labels[r.day_type]??r.day_type}</td><td>{r.planned_start&&r.planned_end?`${r.planned_start} - ${r.planned_end}`:'-'}</td><td>{r.check_in??'-'}</td><td>{r.check_out??'-'}</td><td><span className={`status-badge ${r.attendance_status}`}>{labels[r.attendance_status]??r.attendance_status}</span></td><td>{r.late_minutes} دقيقة</td><td>{(r.worked_minutes/60).toFixed(1)}</td></tr>)}</tbody></table></div>}</section>
  </main>
}
