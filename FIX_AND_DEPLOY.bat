@echo off
chcp 65001 >nul
cd /d "%~dp0"
if not exist package.json (
  echo ERROR: Put this file inside the emora-hr folder that contains package.json.
  pause
  exit /b 1
)
if not exist app\setup mkdir app\setup
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=''; [System.IO.File]::WriteAllBytes('app\setup\page.tsx',[System.Convert]::FromBase64String($b))"
if errorlevel 1 (
  echo Failed to apply the setup fix.
  pause
  exit /b 1
)
echo Setup fix applied successfully.
echo Starting Cloudflare deployment...
call npm run deploy
pause
